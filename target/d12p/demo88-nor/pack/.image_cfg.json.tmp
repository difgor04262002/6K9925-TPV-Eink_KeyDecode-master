{
    "spi-nand": { // Device, The name should be the same with string in image:info:media:type
        "size": "512m", // W25N04KVxxIR/U: 4G-bit, 2048+128, 64 pages/block, 4096 blocks
        "partitions": {
            "spl":        { "size": "1m" },
            "env":        { "size": "128k" },
            "env_r":      { "size": "128k" },
            "userid":     { "size": "256k" }, // at least 16KB
            "os":         { "size": "4m" },
            "rodata":     { "size": "4m" },
            "data": {
                "size": "16m",
                "nftl": {
                    "data": { "size": "-" },
                },
            },
        },
    },
    "image": {
        "info": { // Header information about image
            "platform": "d12p",
            "product": "demo88-nor",
            "flash": "W25N04KV",
            "version": "1.0.0",
            "media": {
                "type": "spi-nand",
                "device_id": 0,
                "array_organization": [
                    { "page": "2k", "block": "128k", "oob": "128" },
                ],
            },
        },
        "updater": { // Image writer which is downloaded to RAM by USB
            "psram": {
                "file": "usbupg-psram-init.aic",
                "attr": ["required", "run"],
                "ram": "0x30043000"
            },
             "spl": {
                 "file": "bootloader.aic",
                 "attr": ["required", "run"],
                 "ram": "0x406c0000",
             },
        },
        "target": { // Image components which will be burn to device's partitions
             "spl": {
                 "file": "spl_boot.aic",
                 "attr": ["mtd", "required"],
                 "part": ["spl"],
             },
            "env": {
                "file": "env.bin",
                "attr": ["mtd", "optional"],
                "part": ["env"]
            },
            "env_r": {
                "file": "env.bin",
                "attr": ["mtd", "optional"],
                "part": ["env_r"]
            },
            "os": {
                "file": "d12p_os.itb",
                "attr": ["mtd", "required"],
                "part": ["os"],
            },
            "rodata": {
                "file": "rodata.fatfs",
                "attr": ["mtd", "optional"],
                "part": ["rodata"]
            },
            "data": {
                "file": "data.fatfs",
                "attr": ["block", "optional"],
                "part": ["data"]
            },
        },
    },
    "pre-process": {
	"aicimage": {
            "usbupg-psram-init.aic": { // No loader, only PreBootProgram to initialize PSRAM
                "head_ver": "0x00010001",
                "resource": {
                    "private2": "pbp_cfg.bin",
                    "pbp2": "d12p.pbp",
                },
            },
             "bootloader.aic": {
                 "head_ver": "0x00010001",
                 "loader": {
                     "file": "bootloader.bin",
                     "load address": "0x406c0000",
                     "entry point": "0x406c0100", // 256 byte aic header
                     "run in dram": "false",
                 },
                "resource": {
                    "private2": "pbp_cfg.bin",
                    "pbp2": "d12p.pbp",
                },
             },
             "spl_boot.aic": {
                 "head_ver": "0x00010001",
                 "loader": {
                     "file": "spl_boot.bin",
                     "load address": "0x406c0000",
                     "entry point": "0x406c0100",
                     "run in dram": "false",
                 },
                "resource": {
                    "private2": "pbp_cfg.bin",
                    "pbp2": "d12p.pbp",
                },
             },
         },
        "itb": {
            "d12p_os.itb": {
                "its": "d12p_os.its",
            },
        },
        "uboot_env": {
            "env.bin": {
                "file": "env.txt",
                "size": "4096",
                "redundant": "enable",
            },
        },
    },
}
