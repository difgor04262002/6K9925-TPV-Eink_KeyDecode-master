{
    "spi-nor": {
        "size": "64m",
        "partitions": {
            "spl":        { "size": "1m" },
            "env":        { "size": "128k" },
            "env_r":      { "size": "128k" },
            "userid":     { "size": "256k" },
            "os":         { "size": "4m" },
            "rodata":     { "size": "4m" },
            "data":       { "size": "55808k" }
        }
    },
    "image": {
        "info": {
            "platform": "d12p",
            "product": "demo88-mx25",
            "flash": "MX25L51245G",
            "version": "1.0.0",
            "media": {
                "type": "spi-nor",
                "device_id": 0
            }
        },
        "updater": {
            "psram": {
                "file": "usbupg-psram-init.aic",
                "attr": ["required", "run"],
                "ram": "0x30043000"
            },
            "spl": {
                "file": "bootloader.aic",
                "attr": ["required", "run"],
                "ram": "0x406c0000"
            }
        },
        "target": {
            "spl": {
                "file": "bootloader.aic",
                "attr": ["mtd", "required"],
                "part": ["spl"]
            },
            "env": {
                "file": "env.bin",
                "attr": ["mtd", "optional"],
                "part": ["env"]
            },
            "env_r": {
                "file": "env.bin",
                "attr": ["mtd", "optional"],
                "part": ["env_r"]
            },
            "os": {
                "file": "d12p_os.itb",
                "attr": ["mtd", "required"],
                "part": ["os"]
            },
            "rodata": {
                "file": "rodata.fatfs",
                "attr": ["mtd", "optional"],
                "part": ["rodata"]
            },
            "data": {
                "file": "data.fatfs",
                "attr": ["mtd", "optional"],
                "part": ["data"]
            }
        }
    },
    "pre-process": {
        "aicimage": {
            "usbupg-psram-init.aic": {
                "head_ver": "0x00010001",
                "resource": {
                    "private2": "pbp_cfg.bin",
                    "pbp2": "d12p.pbp"
                }
            },
            "bootloader.aic": {
                "head_ver": "0x00010001",
                "loader": {
                    "file": "bootloader.bin",
                    "load address": "0x406c0000",
                    "entry point": "0x406c0100",
                    "run in dram": "false"
                },
                "resource": {
                    "private2": "pbp_cfg.bin",
                    "pbp2": "d12p.pbp"
                }
            }
        },
        "itb": {
            "d12p_os.itb": {
                "its": "d12p_os.its"
            }
        },
        "uboot_env": {
            "env.bin": {
                "file": "env.txt",
                "size": "4096",
                "redundant": "enable"
            }
        }
    }
}
